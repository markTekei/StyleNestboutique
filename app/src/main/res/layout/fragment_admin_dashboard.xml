<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/admin_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Dashboard"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Stats Overview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stats_card"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/brand_gold_light"
            app:layout_constraintTop_toBottomOf="@id/admin_title"
            app:strokeWidth="0dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="16dp"
                android:rowCount="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Sales"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/brand_gold_dark" />
                    <TextView
                        android:id="@+id/total_sales_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KES 245,000"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Orders"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/brand_gold_dark" />
                    <TextView
                        android:id="@+id/total_orders_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="142"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Products"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/brand_gold_dark" />
                    <TextView
                        android:id="@+id/total_products_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="48"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customers"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/brand_gold_dark" />
                    <TextView
                        android:id="@+id/total_customers_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="856"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                </LinearLayout>
            </GridLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/management_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Inventory Management"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/stats_card" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_product_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Add New Product"
            android:gravity="start|center_vertical"
            app:icon="@drawable/ic_search"
            app:iconPadding="16dp"
            app:layout_constraintTop_toBottomOf="@id/management_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manage_inventory_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="Manage Stock Levels"
            android:gravity="start|center_vertical"
            app:icon="@drawable/ic_categories"
            app:iconPadding="16dp"
            app:layout_constraintTop_toBottomOf="@id/add_product_button" />

        <TextView
            android:id="@+id/orders_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Order Management"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/manage_inventory_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pending_orders_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Pending Deliveries"
            android:gravity="start|center_vertical"
            app:icon="@drawable/ic_home"
            app:iconPadding="16dp"
            app:layout_constraintTop_toBottomOf="@id/orders_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sales_report_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="Generate Sales Report"
            android:gravity="start|center_vertical"
            app:icon="@drawable/ic_dress"
            app:iconPadding="16dp"
            app:layout_constraintTop_toBottomOf="@id/pending_orders_button" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
