<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.stylenestboutique.ui.home.HomeFragment"
        android:label="STYLENEST"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_home_to_list"
            app:destination="@id/productListFragment" />
        <action
            android:id="@+id/action_home_to_wishlist"
            app:destination="@id/navigation_wishlist" />
    </fragment>

    <fragment
        android:id="@+id/navigation_categories"
        android:name="com.example.stylenestboutique.ui.categories.CategoriesFragment"
        android:label="Categories"
        tools:layout="@layout/fragment_categories">
        <action
            android:id="@+id/action_categories_to_list"
            app:destination="@id/productListFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_cart"
        android:name="com.example.stylenestboutique.ui.cart.CartFragment"
        android:label="Cart"
        tools:layout="@layout/fragment_cart">
        <action
            android:id="@+id/action_cart_to_checkout"
            app:destination="@id/checkoutFragment" />
        <action
            android:id="@+id/action_cart_to_savedDetails"
            app:destination="@id/savedDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_wishlist"
        android:name="com.example.stylenestboutique.ui.wishlist.WishlistFragment"
        android:label="My Wishlist"
        tools:layout="@layout/fragment_wishlist" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.stylenestboutique.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_orderHistory"
            app:destination="@id/orderHistoryFragment" />
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_profile_to_admin"
            app:destination="@id/adminDashboardFragment" />
        <action
            android:id="@+id/action_profile_to_wishlist"
            app:destination="@id/navigation_wishlist" />
        <action
            android:id="@+id/action_profile_to_savedDetails"
            app:destination="@id/savedDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.stylenestboutique.ui.productdetail.ProductDetailFragment"
        android:label="Product Details"
        tools:layout="@layout/fragment_product_detail" />

    <fragment
        android:id="@+id/productListFragment"
        android:name="com.example.stylenestboutique.ui.productlist.ProductListFragment"
        android:label="Products"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_list_to_detail"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="com.example.stylenestboutique.ui.checkout.CheckoutFragment"
        android:label="Checkout"
        tools:layout="@layout/fragment_checkout" />

    <fragment
        android:id="@+id/orderHistoryFragment"
        android:name="com.example.stylenestboutique.ui.profile.OrderHistoryFragment"
        android:label="Order History"
        tools:layout="@layout/fragment_order_history" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.stylenestboutique.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_savedDetails"
            app:destination="@id/savedDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.example.stylenestboutique.ui.admin.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_dashboard">
        <action
            android:id="@+id/action_admin_to_addProduct"
            app:destination="@id/addProductFragment" />
    </fragment>

    <fragment
        android:id="@+id/addProductFragment"
        android:name="com.example.stylenestboutique.ui.admin.AddProductFragment"
        android:label="Add Product"
        tools:layout="@layout/fragment_add_product" />

    <fragment
        android:id="@+id/savedDetailsFragment"
        android:name="com.example.stylenestboutique.ui.profile.SavedDetailsFragment"
        android:label="Saved Details"
        tools:layout="@layout/fragment_saved_details">
        <action
            android:id="@+id/action_savedDetails_to_map"
            app:destination="@id/mapFragment" />
    </fragment>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.stylenestboutique.ui.profile.MapFragment"
        android:label="Select Location"
        tools:layout="@layout/fragment_map" />
</navigation>