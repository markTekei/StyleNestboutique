<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.StyleNestBoutique" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Identity -->
        <item name="colorPrimary">@color/brand_gold</item>
        <item name="colorOnPrimary">@color/charcoal</item>

        <item name="colorPrimaryContainer">@color/brand_gold_dark</item>
        <item name="colorOnPrimaryContainer">@color/brand_gold_light</item>

        <item name="colorSecondary">@color/brand_gold_light</item>
        <item name="colorOnSecondary">@color/charcoal</item>

        <!-- Surfaces and Backgrounds (Brightened for legibility) -->
        <item name="android:windowBackground">@color/black</item>
        <item name="colorSurface">#1E1E1E</item> <!-- Lighter Charcoal -->
        <item name="colorOnSurface">@color/off_white</item>
        <item name="colorSurfaceVariant">#2C2C2C</item> <!-- Distinct Surface -->
        <item name="colorOnSurfaceVariant">@color/gray_light</item>
        <item name="colorOutline">@color/brand_gold_dark</item>
        <item name="colorError">#FF8A80</item>

        <!-- Status and Navigation Bars -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>

        <item name="materialButtonStyle">@style/StyleNest.Button</item>
        <item name="chipStyle">@style/StyleNest.Chip</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.StyleNestBoutique</item>
    </style>
</resources>