<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode -->
    <style name="Base.Theme.StyleNestBoutique" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors - Gold -->
        <item name="colorPrimary">@color/brand_gold</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/brand_gold_dark</item>
        <item name="colorOnPrimaryContainer">@color/brand_gold_light</item>

        <!-- Secondary/Accent colors - Off-white/Gray for dark mode -->
        <item name="colorSecondary">@color/white_pure</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/charcoal</item>
        <item name="colorOnSecondaryContainer">@color/white_pure</item>

        <!-- Background and Surface -->
        <item name="android:windowBackground">@color/black</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white_pure</item>
        <item name="colorSurfaceVariant">@color/charcoal</item>
        <item name="colorOnSurfaceVariant">@color/gray_medium</item>
        <item name="colorOutline">@color/gray_dark</item>
        <item name="colorOutlineVariant">@color/charcoal</item>

        <!-- Status and Navigation Bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Material Components Styles -->
        <item name="materialButtonStyle">@style/StyleNest.Button</item>
        <item name="chipStyle">@style/StyleNest.Chip</item>
    </style>
</resources>