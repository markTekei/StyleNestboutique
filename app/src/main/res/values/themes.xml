<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Premium High-Visibility Light Theme -->
    <style name="Base.Theme.StyleNestBoutique" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">#1A2238</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Header & Banner Roles -->
        <item name="colorPrimaryContainer">#FFFDF5</item> <!-- Luminous White-Gold -->
        <item name="colorOnPrimaryContainer">#1A2238</item>

        <item name="colorSecondary">#D4AF37</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Surfaces (Max Contrast) -->
        <item name="android:windowBackground">#F8F9FA</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item> <!-- Pure Black text -->
        <item name="colorSurfaceVariant">#F1F3F4</item>
        <item name="colorOnSurfaceVariant">#202124</item> <!-- Very dark gray -->
        <item name="colorOutline">#D4AF37</item>
        <item name="colorError">#D93025</item>

        <!-- Components -->
        <item name="materialButtonStyle">@style/StyleNest.Button</item>
        <item name="chipStyle">@style/StyleNest.Chip</item>
    </style>

    <style name="Theme.StyleNestBoutique" parent="Base.Theme.StyleNestBoutique" />

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.StyleNestBoutique</item>
    </style>

    <style name="StyleNest.Button" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StyleNest.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?attr/colorSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="chipIconTint">?attr/colorPrimary</item>
    </style>
</resources>